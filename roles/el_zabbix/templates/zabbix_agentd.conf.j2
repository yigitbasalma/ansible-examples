# Gaia'nın yazdığı Zabbix ajanı ayarları ({{ gaia_contract }}); elle
# değiştirilirse bir sonraki run geri alır. Ek ayarlar (UserParameter vb.)
# zabbix_agentd.d altına konur.
PidFile=/run/zabbix/zabbix_agentd.pid
LogFile=/var/log/zabbix/zabbix_agentd.log
LogFileSize=0

Server={{ zabbix_server | join(',') }}
ServerActive={{ zabbix_server | map('regex_replace', '$', ':' ~ zabbix_server_port) | join(',') }}
ListenPort={{ zabbix_listen_port }}
Hostname={{ zabbix_effective_hostname }}
HostMetadata={{ zabbix_effective_metadata }}
{% if zabbix_psk_enabled %}

TLSConnect=psk
TLSAccept=psk
TLSPSKIdentity={{ zabbix_tls_psk_identity }}
TLSPSKFile=/etc/zabbix/zabbix_agentd.psk
{% endif %}

Include=/etc/zabbix/zabbix_agentd.d/*.conf
